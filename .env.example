# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && ${EDITOR:-nano} .env
# Load it with:  set -a && source .env && set +a

# ---- required -------------------------------------------------------------

# API key from https://build.nvidia.com (click any model -> "Get API Key").
# Used for the LLM, the vision model, and Riva ASR/TTS.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- robot ----------------------------------------------------------------

REACHY_IP=192.168.1.2

# Only needed for the mic hardware test in server.py, which shells into the
# robot. Everything in voice_agent.py works without it. Prefer SSH key auth.
# REACHY_SSH_USER=pollen
# REACHY_SSH_PASS=

# ---- models ---------------------------------------------------------------
# Defaults are chosen for conversational latency, measured on build.nvidia.com:
#   mistral-nemotron 0.41s | llama-3.1-8b 1.15s | llama-3.3-70b timed out.

# REACHY_LLM=mistralai/mistral-nemotron
# REACHY_VLM=nvidia/nemotron-nano-12b-v2-vl

# ---- wake word ------------------------------------------------------------

# "hey" is easy to say but fires on ordinary conversation; "hey reachy" is
# far more selective in a shared room.
# REACHY_WAKE_PHRASE=hey

# Local wake detection (faster-whisper). When on, audio never leaves this
# machine until the wake phrase is heard. Strongly recommended near other
# people. Set to 0 to fall back to cloud wake matching.
# REACHY_LOCAL_WAKE=1
# REACHY_LOCAL_WAKE_MODEL=tiny.en

# Reply to EVERY utterance with no wake word at all. Convenient for a first
# solo test; do not use it around other people -- it answers out loud to
# whatever it hears and sends every utterance to cloud ASR.
# REACHY_NO_WAKE=0

# ---- voice activity detection --------------------------------------------
# Thresholds are multiples of the measured room noise floor, with absolute
# minimums as a backstop. Raise the floors in a noisy room; lower them if it
# is not hearing you. Watch the [audio] heartbeat to tune.

# REACHY_VAD_ON_MULT=6.0
# REACHY_VAD_OFF_MULT=3.0
# REACHY_VAD_ON_FLOOR=400
# REACHY_VAD_OFF_FLOOR=200

# ---- audio output ---------------------------------------------------------
# Magpie returns audio at ~30% of full scale; this normalises it before upload.

# REACHY_TTS_PEAK=0.97
# REACHY_TTS_MAX_GAIN=8.0
